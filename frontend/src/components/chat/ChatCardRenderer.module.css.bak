.weatherTitleWidget {
    font-size: 13px !important;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100vw;
    min-width: 0;
    display: block;
}
/* Widget: 1 cột, bỏ padding trái, full width */
.weatherMainGridWidget {
    display: block;
    width: 100%;
    padding-left: 0 !important;
}
.weatherHeaderRowWidget {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
    padding-left: 0;
}
.weatherMetaRowWidget {
    gap: 10px !important;
    flex-wrap: nowrap;
    min-width: 0;
    overflow: hidden;
}
.weatherCurrentRowWidget {
    align-items: stretch !important;
    min-height: 0;
    padding-left: 0 !important;
}
.weatherCurrentMetaWidget {
    justify-content: space-between !important;
    height: 100%;
    gap: 0 !important;
    display: flex;
    flex-direction: column;
}
@media (max-width: 600px) {
    .weatherTitleWidget {
        font-size: 11px !important;
        max-width: 90px;
    }
    .weatherCurrentRowWidget {
        min-height: 38px;
    }
}
/* Thông tin bên trái: 2 dòng, meta ngang */
.weatherCurrentMeta2 {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    gap: 8px;
}
.weatherDesc {
    font-size: 15px;
    font-weight: 600;
    color: #334155;
    margin-bottom: 2px;
}
.weatherMetaRow {
    display: flex;
    flex-direction: row;
    gap: 18px;
    align-items: center;
    font-size: 13px;
    color: #334155;
}
.weatherMetaLine {
    display: flex;
    align-items: center;
    gap: 4px;
}
@media (max-width: 600px) {
    .weatherCard {
        padding: 10px 6px 10px 6px;
    }
    .weatherCurrentMeta2 {
        gap: 4px;
    }
    .weatherMetaRow {
        gap: 8px;
        font-size: 11px;
    }
    .weatherDesc {
        font-size: 12px;
    }
}
/* Forecast: ngày-tháng, icon mưa cùng dòng */
.weatherForecastDateRow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    margin-bottom: 2px;
}
@media (max-width: 900px) {
    .weatherForecastDateRow {
        gap: 4px;
    }
}
@media (max-width: 600px) {
    .weatherForecastDateRow {
        gap: 2px;
    }
}
/* Forecast Pro: tối ưu chiều ngang, giảm khoảng trống, UI chuyên nghiệp */
.weatherForecast {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    height: 100%;
    align-items: stretch;
}
.weatherForecastDayPro {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 8px 2px 8px 2px;
    text-align: center;
    min-width: 0;
    min-height: 90px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
}
.weatherForecastIconPro {
    font-size: 26px;
    margin-bottom: 2px;
    line-height: 1;
}
.weatherForecastTempsPro {
    font-size: 15px;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 2px;
}
.weatherForecastRainPro {
    font-size: 12px;
    color: #0ea5e9;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
}
.weatherForecastDate {
    font-size: 11px;
    color: #64748b;
    margin-bottom: 2px;
}
@media (max-width: 900px) {
    .weatherForecast {
        grid-template-columns: 1fr 1fr 1fr;
        gap: 4px;
    }
    .weatherForecastDayPro {
        padding: 5px 1px 5px 1px;
        border-radius: 6px;
        min-height: 70px;
    }
    .weatherForecastIconPro {
        font-size: 20px;
    }
    .weatherForecastTempsPro {
        font-size: 12px;
    }
}
@media (max-width: 600px) {
    .weatherForecast {
        grid-template-columns: 1fr 1fr 1fr;
        gap: 2px;
    }
    .weatherForecastDayPro {
        padding: 3px 0 3px 0;
        border-radius: 4px;
        min-height: 48px;
    }
    .weatherForecastIconPro {
        font-size: 15px;
    }
    .weatherForecastTempsPro {
        font-size: 10px;
    }
}
/* Weather Card: căn giữa dọc, icon chung cụm, forecast bóng */
.weatherHeaderRow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 4px;
    padding-left: 10px;
}
.weatherHeaderInfo {
    display: flex;
    flex-direction: column;
    justify-content: center;
}
.weatherCurrentRowCentered {
    display: flex;
    align-items: center;
    gap: 12px;
    justify-content: flex-start;
    padding-left: 10px;
    margin-bottom: 6px;
    min-height: 60px;
}
@media (max-width: 600px) {
    .weatherHeaderRow, .weatherCurrentRowCentered {
        padding-left: 3px;
        gap: 7px;
    }
    .weatherCurrentRowCentered {
        min-height: 38px;
    }
}
/* Hiệu ứng bóng cho forecast */
.weatherForecastDayShadow {
    box-shadow: 0 2px 10px 0 rgba(59,130,246,0.10), 0 1.5px 4px 0 rgba(0,0,0,0.04);
    transition: box-shadow 0.18s, transform 0.18s;
}
.weatherForecastDayShadow:hover {
    box-shadow: 0 6px 18px 0 rgba(59,130,246,0.18), 0 2px 8px 0 rgba(0,0,0,0.07);
    transform: translateY(-2px) scale(1.03);
    z-index: 1;
}
/* --- Layout Containers --- */
.optionsContainer {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 8px 0;
}
.fieldCardGrid {
    display: flex;
    gap: 12px;
}
