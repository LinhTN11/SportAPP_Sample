# =============================================================
# .env.example — BookingSport App Environment Variables
# =============================================================
# Copy this file to `.env` in backend/ and fill in your values.
# NEVER commit the actual .env file to version control!
# =============================================================

# ── Database ──
# PostgreSQL connection string
# Local:  postgresql://user:password@localhost:5432/bookingsport
# Render: Render provides this automatically via DATABASE_URL
DATABASE_URL=postgresql://user:password@localhost:5432/bookingsport

# ── App Settings ──
# Environment: development | production
NODE_ENV=development
# Server port (Render overrides this to 10000 in production)
PORT=5000

# ── Authentication ──
# Secret key for JWT token signing (use a long random string in production)
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ── CORS ──
# Frontend URL(s) allowed to access the API (comma-separated for multiple)
# Local:  http://localhost:3000
# Render: https://bookingsport-frontend.onrender.com
CLIENT_URL=http://localhost:3000

# ── Redis (Optional) ──
# Set to true to enable Socket.io Redis adapter for multi-instance scaling
REDIS_ENABLED=false
# Redis connection URL (only needed if REDIS_ENABLED=true)
# REDIS_URL=redis://localhost:6379

# ── Email (Optional) ──
# SMTP settings for notification emails
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# ── Frontend (.env.local in frontend/) ──
# NEXT_PUBLIC_API_URL=http://localhost:5000/api
